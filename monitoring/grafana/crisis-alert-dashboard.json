      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(pubsub_serialization_errors_total{topic=~\"$topic\"}[5m])) by (topic)",
          "legendFormat": "{{ topic }}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
